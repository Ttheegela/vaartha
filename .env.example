# Instance: owner (real Plaid, Tailscale-only) or demo (Plaid Sandbox, public)
VARTA_INSTANCE=demo
VARTA_DB_PATH=data/varta.db
# Plaid: sandbox | production (demo must be sandbox)
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# TOKEN_ENCRYPTION_KEY: generate with `uv run python -m scripts.new_token_key >> .env`
# News + sentiment (all optional; missing ones are skipped)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=
TYPESAFE_API_KEY=
# SEC asks for a descriptive User-Agent with contact info, e.g. "Varta you@example.com"
SEC_USER_AGENT=
# Later sub-projects add: LLM_BASE_URL, LLM_MODEL, OPENROUTER_API_KEY, REDDIT_*
