# Instance: owner (real Plaid, Tailscale-only) or demo (Plaid Sandbox, public)
VARTA_INSTANCE=demo
VARTA_DB_PATH=data/varta.db
# Plaid: sandbox | production (demo must be sandbox)
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Generate with: uv run python -m scripts.new_token_key >> .env
TOKEN_ENCRYPTION_KEY=
# Later sub-projects add: LLM_BASE_URL, LLM_MODEL, OPENROUTER_API_KEY,
# TYPESAFE_API_KEY, ALPACA_*, FINNHUB_API_KEY, REDDIT_*
