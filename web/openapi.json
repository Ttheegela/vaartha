{
  "components": {
    "schemas": {
      "AccountOut": {
        "description": "One account with its cached balances.",
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          },
          "balance_available": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Balance Available"
          },
          "balance_current": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Balance Current"
          },
          "institution": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Institution"
          },
          "is_liability": {
            "title": "Is Liability",
            "type": "boolean"
          },
          "mask": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mask"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "subtype": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtype"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "institution",
          "name",
          "type",
          "subtype",
          "mask",
          "balance_current",
          "balance_available",
          "is_liability"
        ],
        "title": "AccountOut",
        "type": "object"
      },
      "AccountsOut": {
        "description": "Accounts, items and asset/liability totals.",
        "properties": {
          "accounts": {
            "items": {
              "$ref": "#/components/schemas/AccountOut"
            },
            "title": "Accounts",
            "type": "array"
          },
          "assets": {
            "title": "Assets",
            "type": "number"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ItemOut"
            },
            "title": "Items",
            "type": "array"
          },
          "liabilities": {
            "title": "Liabilities",
            "type": "number"
          }
        },
        "required": [
          "accounts",
          "items",
          "assets",
          "liabilities"
        ],
        "title": "AccountsOut",
        "type": "object"
      },
      "BudgetOut": {
        "description": "A monthly category budget with this month's spend.",
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "limit": {
            "title": "Limit",
            "type": "number"
          },
          "spent": {
            "title": "Spent",
            "type": "number"
          }
        },
        "required": [
          "category",
          "limit",
          "spent"
        ],
        "title": "BudgetOut",
        "type": "object"
      },
      "CashFlowMonth": {
        "description": "Income and spend for one month (YYYY-MM).",
        "properties": {
          "income": {
            "title": "Income",
            "type": "number"
          },
          "month": {
            "title": "Month",
            "type": "string"
          },
          "spend": {
            "title": "Spend",
            "type": "number"
          }
        },
        "required": [
          "month",
          "income",
          "spend"
        ],
        "title": "CashFlowMonth",
        "type": "object"
      },
      "CategorySpend": {
        "description": "Total spend for one category.",
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "number"
          },
          "category": {
            "title": "Category",
            "type": "string"
          }
        },
        "required": [
          "category",
          "amount"
        ],
        "title": "CategorySpend",
        "type": "object"
      },
      "GoalOut": {
        "description": "A savings goal with progress toward its target.",
        "properties": {
          "current": {
            "title": "Current",
            "type": "number"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "months_left": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Months Left"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "progress": {
            "title": "Progress",
            "type": "number"
          },
          "target_amount": {
            "title": "Target Amount",
            "type": "number"
          },
          "target_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Date"
          }
        },
        "required": [
          "id",
          "name",
          "target_amount",
          "target_date",
          "current",
          "progress",
          "months_left"
        ],
        "title": "GoalOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ItemOut": {
        "description": "A linked institution connection.",
        "properties": {
          "institution": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Institution"
          },
          "item_id": {
            "title": "Item Id",
            "type": "string"
          },
          "last_synced_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Synced At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "institution",
          "status",
          "last_synced_at"
        ],
        "title": "ItemOut",
        "type": "object"
      },
      "MerchantSpendOut": {
        "description": "Total spend and transaction count for one merchant.",
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "number"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "merchant": {
            "title": "Merchant",
            "type": "string"
          }
        },
        "required": [
          "merchant",
          "category",
          "amount",
          "count"
        ],
        "title": "MerchantSpendOut",
        "type": "object"
      },
      "NetWorthPoint": {
        "description": "One daily net-worth snapshot.",
        "properties": {
          "assets": {
            "title": "Assets",
            "type": "number"
          },
          "date": {
            "title": "Date",
            "type": "string"
          },
          "liabilities": {
            "title": "Liabilities",
            "type": "number"
          },
          "net": {
            "title": "Net",
            "type": "number"
          }
        },
        "required": [
          "date",
          "assets",
          "liabilities",
          "net"
        ],
        "title": "NetWorthPoint",
        "type": "object"
      },
      "RecurringListOut": {
        "description": "Subscriptions and bills with active monthly totals.",
        "properties": {
          "bills": {
            "items": {
              "$ref": "#/components/schemas/RecurringOut"
            },
            "title": "Bills",
            "type": "array"
          },
          "bills_monthly": {
            "title": "Bills Monthly",
            "type": "number"
          },
          "subscriptions": {
            "items": {
              "$ref": "#/components/schemas/RecurringOut"
            },
            "title": "Subscriptions",
            "type": "array"
          },
          "subscriptions_monthly": {
            "title": "Subscriptions Monthly",
            "type": "number"
          }
        },
        "required": [
          "subscriptions",
          "bills",
          "subscriptions_monthly",
          "bills_monthly"
        ],
        "title": "RecurringListOut",
        "type": "object"
      },
      "RecurringOut": {
        "description": "A detected recurring stream with its monthly-normalized amount.",
        "properties": {
          "avg_amount": {
            "title": "Avg Amount",
            "type": "number"
          },
          "frequency": {
            "enum": [
              "WEEKLY",
              "MONTHLY",
              "ANNUALLY"
            ],
            "title": "Frequency",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "subscription",
              "bill",
              "income"
            ],
            "title": "Kind",
            "type": "string"
          },
          "last_amount": {
            "title": "Last Amount",
            "type": "number"
          },
          "last_date": {
            "title": "Last Date",
            "type": "string"
          },
          "merchant": {
            "title": "Merchant",
            "type": "string"
          },
          "monthly_amount": {
            "title": "Monthly Amount",
            "type": "number"
          },
          "predicted_next_date": {
            "title": "Predicted Next Date",
            "type": "string"
          },
          "stream_id": {
            "title": "Stream Id",
            "type": "string"
          }
        },
        "required": [
          "stream_id",
          "merchant",
          "kind",
          "frequency",
          "avg_amount",
          "last_amount",
          "last_date",
          "predicted_next_date",
          "is_active",
          "monthly_amount"
        ],
        "title": "RecurringOut",
        "type": "object"
      },
      "RegimeOut": {
        "description": "Regime as served to clients.",
        "properties": {
          "brent_vol": {
            "title": "Brent Vol",
            "type": "number"
          },
          "gold_oil": {
            "title": "Gold Oil",
            "type": "number"
          },
          "label": {
            "enum": [
              "Normal",
              "Elevated",
              "Crisis"
            ],
            "title": "Label",
            "type": "string"
          },
          "prob": {
            "title": "Prob",
            "type": "number"
          },
          "signals": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Signals",
            "type": "object"
          },
          "spy_dd": {
            "title": "Spy Dd",
            "type": "number"
          }
        },
        "required": [
          "label",
          "prob",
          "brent_vol",
          "spy_dd",
          "gold_oil",
          "signals"
        ],
        "title": "RegimeOut",
        "type": "object"
      },
      "SpendingOut": {
        "description": "Month spending breakdown plus six months of cash flow.",
        "properties": {
          "by_category": {
            "items": {
              "$ref": "#/components/schemas/CategorySpend"
            },
            "title": "By Category",
            "type": "array"
          },
          "by_merchant": {
            "items": {
              "$ref": "#/components/schemas/MerchantSpendOut"
            },
            "title": "By Merchant",
            "type": "array"
          },
          "cash_flow": {
            "items": {
              "$ref": "#/components/schemas/CashFlowMonth"
            },
            "title": "Cash Flow",
            "type": "array"
          },
          "month": {
            "title": "Month",
            "type": "string"
          }
        },
        "required": [
          "month",
          "by_category",
          "by_merchant",
          "cash_flow"
        ],
        "title": "SpendingOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "V\u0101rt\u0101 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/accounts": {
      "get": {
        "description": "Linked accounts with cached balances, items, and asset/liability totals.",
        "operationId": "accounts_api_accounts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Accounts"
      }
    },
    "/api/budgets": {
      "get": {
        "description": "Monthly budgets with this month's spend per category.",
        "operationId": "budgets_api_budgets_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BudgetOut"
                  },
                  "title": "Response Budgets Api Budgets Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Budgets"
      }
    },
    "/api/goals": {
      "get": {
        "description": "Goals with current balance of linked accounts and months remaining.",
        "operationId": "goals_api_goals_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/GoalOut"
                  },
                  "title": "Response Goals Api Goals Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Goals"
      }
    },
    "/api/networth": {
      "get": {
        "description": "Daily net-worth snapshots for the last `days` days, oldest first.",
        "operationId": "networth_api_networth_get",
        "parameters": [
          {
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 365,
              "maximum": 3650,
              "minimum": 1,
              "title": "Days",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/NetWorthPoint"
                  },
                  "title": "Response Networth Api Networth Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Networth"
      }
    },
    "/api/recurring": {
      "get": {
        "description": "Detected subscriptions and bills with monthly-normalized totals (inactive excluded).",
        "operationId": "recurring_api_recurring_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecurringListOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Recurring"
      }
    },
    "/api/regime": {
      "get": {
        "description": "Current market regime, cached for REGIME_TTL_SECONDS.",
        "operationId": "regime_api_regime_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegimeOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Regime"
      }
    },
    "/api/spending": {
      "get": {
        "description": "Spend by category and top merchants for a month, plus 6 months of cash flow.",
        "operationId": "spending_api_spending_get",
        "parameters": [
          {
            "in": "query",
            "name": "month",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Month"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpendingOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Spending"
      }
    },
    "/healthz": {
      "get": {
        "description": "Liveness plus a trivial DB query.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    }
  }
}
