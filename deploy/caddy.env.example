# Copy to deploy/caddy.env and fill in. Never commit the copy.
# REQUIRED: an empty value breaks the Caddyfile
ACME_EMAIL=
# Public demo hostname
DEMO_DOMAIN=
# VPS MagicDNS name: <host>.<tailnet>.ts.net
OWNER_HOST=
# VPS Tailscale IP (owner site is published only here)
# REQUIRED (compose fails closed if empty)
OWNER_TS_IP=
# VPS public IP (demo site)
# REQUIRED (compose fails closed if empty)
PUBLIC_IP=
