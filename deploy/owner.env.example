# Copy to deploy/owner.env and fill in. Never commit the copy.
VARTA_INSTANCE=owner
# Trial keys
PLAID_ENV=production
# Plaid Production (Trial) keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# OAuth banks (Chase etc.): the exact https URL registered in Plaid Dashboard > API > Allowed redirect URIs
# PLAID_REDIRECT_URI=https://<mac>.<tailnet>.ts.net/oauth-return
# Fernet key: uv run python -m scripts.new_token_key
TOKEN_ENCRYPTION_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=
TYPESAFE_API_KEY=
# Quote values containing spaces. e.g. "Name email@example.com" (SEC requires a contact)
SEC_USER_AGENT=
# Separate OpenRouter key with its own spend cap
OPENROUTER_API_KEY=
VARTA_TZ=America/New_York
# Name shown in the home greeting (owner only; the demo stays anonymous)
OWNER_NAME=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-haiku-4.5
# 0 = unlimited
CHAT_RATE_PER_HOUR=0
# Passkey lock (required; OWNER_AUTH=0 disables it, local dev only). Host and URL of your tailscale serve address.
PASSKEY_RP_ID=<mac>.<tailnet>.ts.net
PASSKEY_ORIGIN=https://<mac>.<tailnet>.ts.net
# Optional: idle minutes before auto-lock (default 15)
# AUTH_IDLE_MINUTES=15
