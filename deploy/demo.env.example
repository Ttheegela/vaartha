# Copy to deploy/demo.env and fill in. Never commit the copy.
VARTA_INSTANCE=demo
PLAID_ENV=sandbox
# Plaid (sandbox for demo)
PLAID_CLIENT_ID=
PLAID_SECRET=
# Fernet key: uv run python -m scripts.new_token_key
TOKEN_ENCRYPTION_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=
TYPESAFE_API_KEY=
# e.g. "Name email@example.com" (SEC requires a contact)
SEC_USER_AGENT=
OPENROUTER_API_KEY=
VARTA_TZ=America/New_York
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-haiku-4.5
CHAT_RATE_PER_HOUR=20
